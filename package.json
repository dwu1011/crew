{
  "name": "crew-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "crew": "dist/cli.js"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "crew": "node dist/cli.js",
    "test": "bun run build && vitest run",
    "test:watch": "bun run build && vitest"
  },
  "trustedDependencies": ["better-sqlite3"],
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "hono": "^4.13.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
